{
  "name": "@qzsecftb/dsh-loop-guard",
  "version": "0.1.0",
  "description": "给 agent 的干活循环加两道刹：同一个动作反复撞墙就停下来告诉你，长任务跑久了中间说一句进展。Two brakes for a stuck agent loop: detect repeated failing actions and narrate long-running work.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "harness",
    "agent",
    "loop",
    "guard",
    "stuck",
    "retry",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "xfgil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfgil/dsh-loop-guard.git"
  },
  "homepage": "https://github.com/xfgil/dsh-loop-guard#readme",
  "bugs": {
    "url": "https://github.com/xfgil/dsh-loop-guard/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}